# Container settings for a Slurm cluster that runs jobs inside a squashfs image
# (`srun --container-image=...`). Used only by setup-cluster-env.sh,
# test-cluster-env.sh and `project-setup.sh cluster`.

# --- Base container image ---
# Option 1 (preferred): an image already staged on your cluster, for example
#   /opt/containers/ngc/pytorch_25.03-py3.sqsh
# The published runs used NGC PyTorch 25.03 (PyTorch 2.7, CUDA 12.8).
# Leave empty to fall back to a per-user copy or an NGC pull.
CLUSTER_BASE_SQSH=

# Option 2 (fallback): pull from the NVIDIA NGC registry. Requires an API key:
#   export ENROOT_LOGIN_USERNAME='$oauthtoken'
#   export ENROOT_LOGIN_PASSWORD='<your-NGC-API-key>'
# Get a key at: https://ngc.nvidia.com -> Setup -> API Key
NGC_IMAGE=nvcr.io/nvidia/pytorch:25.03-py3

# Per-user copy path (created only when pulling from NGC).
USER_BASE_SQSH=$HOME/containers/pytorch-base.sqsh

# Host paths bound into the container, as comma-separated SRC:DST pairs. They
# must cover this repository and your DATASET_DIR / ANNOTATION_DIR /
# CHECKPOINT_DIR. When unset, the scripts mount the repository directory only.
# CONTAINER_MOUNTS=/data:/data,/scratch:/scratch
